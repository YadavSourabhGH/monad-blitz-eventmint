# Private key for deployment (DO NOT COMMIT THIS!)
# Get your private key from MetaMask: Account Details > Export Private Key
PRIVATE_KEY=your_private_key_here_without_0x_prefix

# Monad RPC URLs
MONAD_TESTNET_RPC=https://testnet.monad.xyz
MONAD_MAINNET_RPC=https://rpc.monad.xyz

# Monad Explorer API Key (optional, for contract verification)
MONAD_API_KEY=
